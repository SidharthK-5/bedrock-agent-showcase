# Example Environment Configuration
# Copy this file to .env for local development (DO NOT commit .env to git)

# Database Connection
# Format: postgresql+psycopg://username:password@host:port/database
# The +psycopg driver spec is required (SQLAlchemy defaults to psycopg2
# otherwise, which isn't installed - see MIGRATION_QUICK_REF.md)
# Note: URL-encode special characters in password
DB_URI=postgresql+psycopg://username:password@host.database.azure.com/database

# AWS Configuration (for local testing)
AWS_REGION=us-east-1
AWS_PROFILE=default

# Lambda Configuration
LAMBDA_TIMEOUT=30
LAMBDA_MEMORY=512

# Logging
LOG_LEVEL=INFO
